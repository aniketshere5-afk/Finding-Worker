# ── Finding Worker Frontend — Environment Variables ──
#
# Demo mode lets the frontend run without the Spring Boot backend.
# Set to "false" when connecting to the real backend.
VITE_DEMO_MODE=true

# Backend API URL (only used when VITE_DEMO_MODE=false)
# Local development:
VITE_API_URL=http://localhost:8080
# Production example:
# VITE_API_URL=https://finding-worker-backend.onrender.com
